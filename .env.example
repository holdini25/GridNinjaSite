# Vercel Production:
# NEXT_PUBLIC_SITE_URL=https://gridninja.ai
# CONTACT_ALLOWED_ORIGINS=https://gridninja.ai
# TURNSTILE_ALLOWED_HOSTNAMES=gridninja.ai
# Local public URL and exact browser request allowlists:
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
CONTACT_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Neon / Drizzle.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Cloudflare Turnstile. Use Cloudflare's documented test keys locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAMES=127.0.0.1,localhost

# Upstash Redis rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash publishing and signed internal route verification.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Rotate this independently from provider credentials. Never expose it publicly.
LEAD_PSEUDONYM_SECRET=

# Enterprise delivery observation; secrets are configured only in the host.
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_SECRET_PREVIOUS=
CRON_SECRET=
LEAD_OPERATIONS_SECRET=

# Candidate identity and CSP: use report-only for the first protected staging
# rehearsal, then enforce for the final qualified candidate. Local HTTP omits
# upgrade-insecure-requests; Vercel deployments include it automatically.
GRIDNINJA_CANDIDATE_ID=
GRIDNINJA_CSP_MODE=enforce
GRIDNINJA_HTTPS=0

# Required internal email delivery.
RESEND_API_KEY=
LEAD_EMAIL_FROM=GridNinja <no-reply@gridninja.ai>
LEAD_EMAIL_TO=

# Optional CRM delivery. Configure both values or neither.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SIGNING_SECRET=

# Required in production. Payloads contain operational IDs/status only, never PII.
LEAD_ALERT_WEBHOOK_URL=
LEAD_ALERT_WEBHOOK_TOKEN=

# Staffed delivery rehearsal only. Leave unset until an isolated staging origin,
# dedicated recipient and assigned operator are confirmed. Never use production.
# The operator reference is an opaque roster ID, not an email address.
# STAGING_BASE_URL=
# STAGING_DATABASE_URL=
# STAGING_CANARY_AUTHORIZED_ORIGIN=
# STAGING_CANARY_AUTHORIZED=staging-only
# STAGING_CANARY_EMAIL=
# STAGING_CANARY_OPERATOR_REFERENCE=
# STAGING_CANARY_DELIVERY_EMAIL=
# STAGING_CANARY_EXPECTED_ATTESTATION_SHA256=
# STAGING_CANARY_PREFLIGHT_TOKEN=
# Host-side read-only preflight. Enable only on the isolated staging deployment.
# LEAD_STAGING_PREFLIGHT_ENABLED=staging-only
# LEAD_STAGING_PREFLIGHT_ORIGIN=

# Approved facility illustration. Rebuild/deploy to apply to prerendered home.
# Modes: poster (rollback), manual, auto-desktop, auto-adaptive.
# Public mobile rollout requires recorded device/accessibility gates.
FACILITY_ASSET_RELEASE=facility-v10
FACILITY_3D_MODE=auto-adaptive
# Local authoring only; never overrides the production release registry.
# FACILITY_PREVIEW=1
